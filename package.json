{
  "license": "AGPL-3.0-only",
  "name": "cf-secret-remote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "bun run scripts/ensure-wrangler.ts",
    "dev:api": "bun run --filter @cfs/api dev",
    "build:web": "bun run --filter @cfs/web build",
    "build:cli": "bun run --filter @cfs/cli build",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts/tsconfig.json",
    "test": "bun run --filter '*' test && bun test scripts",
    "test:browser": "bun run --filter @cfs/core test:browser",
    "e2e": "bun run scripts/e2e.ts",
    "adr:check": "bun run scripts/adr-check.ts",
    "lint": "biome check apps packages scripts",
    "format": "biome format --write apps packages scripts",
    "bundle:worker": "bun run scripts/bundle-worker.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cfs/core": "workspace:*",
    "@types/bun": "^1.4.5",
    "typescript": "^5.6.0"
  }
}

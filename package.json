{
  "name": "cf-secret-remote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun run --filter @cfs/api dev",
    "build:web": "bun run --filter @cfs/web build",
    "build:cli": "bun run --filter @cfs/cli build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check apps packages",
    "format": "biome format --write apps packages"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
